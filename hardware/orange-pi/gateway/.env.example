OC_VOICE_PROVIDER=cloud
OC_CLOUD_BASE_URL=https://oc-voice.open.smn.icu
OC_DEVICE_TOKEN=
OC_DEVICE_ID=orangepi-3b-01
OC_CHARACTER=devil
OC_BIND_HOST=127.0.0.1
OC_BIND_PORT=8787
OC_DISPLAY_TRANSPORT=mock

# ADVX display mode (required when OC_DISPLAY_TRANSPORT=advx):
OC_HARDWARE_SERVER_URL=http://127.0.0.1:8781
OC_HARDWARE_SERVER_TOKEN=
OC_HARDWARE_AGENT_ID=orangepi-3b-01
OC_HARDWARE_TARGETS=["left","right"]
# Optional; keys must match targets. Keep blank when screens.json has no token.
OC_HARDWARE_SCREEN_TOKENS={"left":"","right":""}
OC_HARDWARE_ASSET_DIR=/opt/oc-hardware-gateway/assets

# none, wav, or zilo-recorded:
OC_RING_SOURCE=none
# Optional repeatable WAV microphone substitute:
# OC_WAV_INPUT=/opt/oc-hardware-gateway/smoke.wav
# Zilo complete-recording mode (not a live/full-duplex stream):
OC_ZILO_ADDRESS=
OC_ZILO_SDK_PATH=/opt/zilo-whisper-ring-sdk
OC_FFMPEG_PATH=/usr/bin/ffmpeg

# Direct StepFun fallback only; never needed in cloud mode:
# OC_STEPFUN_API_KEY=
