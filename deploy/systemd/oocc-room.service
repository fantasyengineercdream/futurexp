[Unit]
Description=OOCC Room and realtime voice relay
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/oocc/apps/room
EnvironmentFile=/etc/oocc/room.env
ExecStart=/usr/bin/node dist-server/server.mjs
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

