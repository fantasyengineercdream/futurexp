{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oc-voice-lab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_ROOM",
        "class_name": "RealtimeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeRoom"]
    }
  ]
}
